# Port for Practical 06 Server
PORT=5001

# MongoDB Connection String (Local or Cloud MongoDB Atlas)
# Example Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fixit_records_db?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/fixit_records_db
MONGODB_URI=mongodb://127.0.0.1:27017/fixit_records_db

# Environment mode
NODE_ENV=development
